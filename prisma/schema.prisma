// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

model Users {
  id           Int              @id @default(autoincrement())
  name         String
  email        String           @unique
  password     String
  role         Role             @default(USER)
  fcmToken     String?          @map("fcm_token")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  enrollments  Enrollment[]
  progress     LessonProgress[]
  quizAttempts QuizAttempt[]

  @@map("users")
}

model Courses {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?      @map("image_url")
  price       Float        @default(0.0)
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  lessons     Lessons[]
  enrollments Enrollment[]
  quizzes     Quizzes[]

  @@map("courses")
}

model Lessons {
  id        Int              @id @default(autoincrement())
  title     String
  content   String?
  videoId   String           @map("video_id")
  courseId  Int              @map("course_id")
  sequence  Int
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  progress  LessonProgress[]

  course Courses @relation(fields: [courseId], references: [id])

  @@map("lessons")
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  courseId  Int      @map("course_id")
  approved  Boolean  @default(false)
  status    Status   @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   Users   @relation(fields: [userId], references: [id])
  course Courses @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  lessonId  Int      @map("lesson_id")
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   Users   @relation(fields: [userId], references: [id])
  lesson Lessons @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model Quizzes {
  id        Int      @id @default(autoincrement())
  title     String
  courseId  Int      @map("course_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course    Courses       @relation(fields: [courseId], references: [id])
  questions Questions[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Questions {
  id        Int      @id @default(autoincrement())
  question  String
  quizId    Int      @map("quiz_id")
  sequence  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quiz    Quizzes   @relation(fields: [quizId], references: [id])
  answers Answers[]

  @@map("questions")
}

model Answers {
  id         Int      @id @default(autoincrement())
  answer     String
  correct    Boolean  @default(false)
  questionId Int      @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question       Questions        @relation(fields: [questionId], references: [id])
  userSelections UserQuizAnswer[]

  @@map("answers")
}

model QuizAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  quizId    Int      @map("quiz_id")
  score     Float
  passed    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    Users            @relation(fields: [userId], references: [id])
  quiz    Quizzes          @relation(fields: [quizId], references: [id])
  answers UserQuizAnswer[]

  @@map("quiz_attempts")
}

model UserQuizAnswer {
  id        Int @id @default(autoincrement())
  attemptId Int @map("attempt_id")
  answerId  Int @map("answer_id")

  attempt QuizAttempt @relation(fields: [attemptId], references: [id])
  answer  Answers     @relation(fields: [answerId], references: [id])

  @@unique([attemptId, answerId])
  @@map("user_quiz_answers")
}
